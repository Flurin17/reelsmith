# Copy to .env.local (git-ignored). Never commit real values.

# ElevenLabs API key for `reelsmith voiceover`, `voices`, `audition`.
# Needs text-to-speech access; `voices_read` for the voice picker.
ELEVENLABS_API_KEY=

# Anything your custom catalog module needs (e.g. a read-only database URL).
# DATABASE_URL=
